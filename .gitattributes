# 统一换行：源码与数据一律 LF，避免 Windows/Linux 往返时产生整文件 diff
* text=auto eol=lf

*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
Makefile text eol=lf

# 批处理必须保持 CRLF，否则 cmd 解释器行为异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.exe  binary
*.png  binary
*.bmp  binary
*.jpg  binary
*.docx binary
*.pptx binary
*.xlsx binary
